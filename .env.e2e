# The API the end-to-end build talks to.
#
# The device's own localhost, which `adb reverse` forwards to port 3000 on this
# machine — the runner sets that up before the first flow. A reverse tunnel rather
# than the emulator's `10.0.2.2` host alias: the alias goes through the emulator's
# user-mode network stack, which is the flakiest part of it, and the tunnel is
# plain adb and works over USB to a real phone as well.
#
# The suite registers schools, invites tutors and uploads files. It must never do
# that to production — see .maestro/README.md for what to start locally.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
